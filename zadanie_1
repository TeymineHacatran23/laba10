import operator
def sliding_max(lst, k):
  if k <= 0:
    raise ValueError("ValueError")
  if k > len(lst):
    return []
  result = []
  for i in range(len(lst) - k + 1):
    m = lst[i]
    for x in lst[i:i + k]:
      if operator.gt(x, m):
        m = x
    result.append(m)
  return result
print(sliding_max([1, 5, 2, 5, 4], 2))

print(sliding_max([1, 3, 2, 5, 4], 3))

print(sliding_max([1, 2], 3)) 

print(sliding_max([-3, -1, -2], 2)) 

print(sliding_max([1], 0)) 
